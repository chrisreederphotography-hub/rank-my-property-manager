{
  "dataconnect": {
    "source": "firebase/dataconnect"
  },
  "apphosting": {
    "backendId": "rank-my-property-manager",
    "rootDir": "frontend"
  },
  "hosting": {
    "site": "rankmypropertymanager-site",
    "source": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1"
    }
  }
}
